# Fallback without Docker. Needs a system user with UID/GID 10001:
#   useradd --system --uid 10001 --user-group --home /var/lib/nsrelay-web nsrelay
[Unit]
Description=Netsession Relay web (UI, API, configuration database)
After=nsrelay-engine.service
Wants=nsrelay-engine.service

[Service]
EnvironmentFile=-/srv/nsrelay/.env
Environment=NSRELAY_DB=/var/lib/nsrelay-web/nsrelay.db
Environment=NSRELAY_SOCKET=/run/nsrelay/engine.sock
Environment=NSRELAY_BACKUP_DIR=/srv/nsrelay/backups
# Without NSRELAY_HTTP_ADDR the web part listens on 127.0.0.1:8080 only (for a reverse proxy on this host). To
# reach it from the network, set the address in /srv/nsrelay/.env or here; ":8080" = every address of the host
# except the relay addresses in the game networks:
#Environment=NSRELAY_HTTP_ADDR=:8080
ExecStart=/usr/local/bin/nsrelay web
Restart=always
RestartSec=2
User=nsrelay
Group=nsrelay
StateDirectory=nsrelay-web
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/nsrelay/backups
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
